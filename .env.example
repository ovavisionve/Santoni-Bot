# ============================================
# SantoniBot - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to the repository

# ---- General ----
APP_NAME=SantoniBot
APP_ENV=development
DEBUG=true

# ---- Admin ----
# Default: SantoniAdmin2026! (change after first login)
# ADMIN_DEFAULT_PASSWORD=SantoniAdmin2026!

# ---- Backend ----
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# ---- Database (SantoniBot internal) ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=santonibot
POSTGRES_USER=santonibot
POSTGRES_PASSWORD=change-this-password

# ---- iDempiere Database (read-only) ----
# Production: PostgreSQL 13 on Santoni internal network
IDEMPIERE_DB_HOST=192.168.1.73
IDEMPIERE_DB_PORT=5432
IDEMPIERE_DB_NAME=idempiere_produccion
IDEMPIERE_DB_USER=ova
IDEMPIERE_DB_PASSWORD=change-this-password

# ---- AI Providers ----
# AI_PROVIDER: "openrouter" (recommended, cheap), "groq" (free but limited), or "anthropic" (Claude)
# Claude is used automatically for document analysis when ANTHROPIC_API_KEY is set.
AI_PROVIDER=openrouter

# OpenRouter (recommended - many models, pay-as-you-go, no daily limits)
# Get your API key at: https://openrouter.ai/keys
# Models: deepseek/deepseek-chat-v3-0324 ($0.14/M), google/gemini-2.0-flash-001 ($0.10/M)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Groq (free tier: 100K tokens/day - insufficient for production)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Claude API (for document/image analysis - used on-demand, not for every query)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Proxy for Claude API (required in Venezuela due to geographic restrictions)
# Set up a Cloudflare Worker and put its URL here:
ANTHROPIC_BASE_URL=

# ---- ChromaDB ----
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# ---- Sentry (optional - leave empty to disable) ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_DSN=

# ---- Frontend ----
# Leave empty when using Nginx reverse proxy (recommended for production)
# Set to http://localhost:8000 only for local development without Nginx
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=SantoniBot

# ---- Nginx / Domain ----
DOMAIN=localhost

# ---- VM Info (for reference, DO NOT commit real passwords) ----
# VM IP: 192.168.1.26 (Ubuntu Server 25.10)
# VM Specs: 16GB RAM, 8 vCPU, 512GB SSD, 1Gbps
# Public IP: 201.249.55.198
